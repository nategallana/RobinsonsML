# Build output
bin/
obj/

# Ignore common cache files
*.cache
*.dll
*.pdb
*.exe

# VS-specific files and folders
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Other temporary files
*.log
*.tlog
*.tmp

